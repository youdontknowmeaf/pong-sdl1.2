prefix=${PSPDEV}/psp
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: liblzma
Description: General purpose data compression library
URL: https://tukaani.org/xz/
Version: 5.2.10
Cflags: -I${includedir}
Libs: -L${libdir} -llzma
Libs.private:  
