prefix=${PSPDEV}/psp
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${exec_prefix}/lib

Name: libspdlog
Description: Fast C++ logging library.
URL: https://github.com/gabime/spdlog
Version: 1.17.0
CFlags: -I${includedir} -DSPDLOG_COMPILED_LIB -DSPDLOG_FMT_EXTERNAL -DSPDLOG_NO_EXCEPTIONS -DSPDLOG_NO_THREAD_ID -DSPDLOG_NO_ATOMIC_LEVELS
Libs: -L${libdir} -lspdlog -pthread
Requires: fmt

